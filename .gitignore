# ==============================================================================
# 🌿 GuideLanka System — Master .gitignore
# Covers: Node.js Backend, React (Vite) Apps, Flutter Mobile, Databases & OS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🔐 Environment & Secret Configurations
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Private Keys & Keystores
*.pem
*.key
*.p12
*.jks
*.keystore
id_rsa*
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 2. 📦 Node.js & Web Projects (Backend, Authority Dashboard, Tourist Web App)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
out/
.next/
.output/

# Cache directories
.eslintcache
.stylelintcache
.oxlint_cache
.vite/
.turbo/
.cache/
.parcel-cache/

# Testing & Coverage
coverage/
.nyc_output/

# Backend Uploads & Temporary Media (keeps folder structure intact)
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# ------------------------------------------------------------------------------
# 3. 📱 Flutter & Dart (Safari Driver Mobile App)
# ------------------------------------------------------------------------------
# Dart & Flutter core build files
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
**/build/

# Android Specific
driver_mobile/android/.gradle/
driver_mobile/android/local.properties
driver_mobile/android/**/build/
*.apk
*.aab
*.ap_
*.dex

# iOS Specific
driver_mobile/ios/.symlinks/
driver_mobile/ios/Pods/
driver_mobile/ios/Flutter/Flutter.framework
driver_mobile/ios/Flutter/Flutter.podspec
driver_mobile/ios/Flutter/Generated.xcconfig
driver_mobile/ios/Flutter/app.framework
driver_mobile/ios/Runner/GeneratedPluginRegistrant.*
*.ipa

# Flutter Desktop & Web Ephemeral Files
driver_mobile/windows/flutter/ephemeral/
driver_mobile/macos/Flutter/ephemeral/
driver_mobile/linux/flutter/ephemeral/

# ------------------------------------------------------------------------------
# 4. 💻 Operating System & IDE Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# IDEs and Code Editors
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
.project
.classpath
.settings/

# VS Code (ignore user settings, keep shared recommendations/tasks if any)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Antigravity & AI Assistant metadata
.gemini/
